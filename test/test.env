# Environment khusus test API (test/api). Seluruh nilai di sini palsu dan hanya berlaku
# untuk kontainer test lokal yang didefinisikan di docker-compose.test.yml — aman untuk
# di-commit. JANGAN pernah memakai nilai ini (atau pola port/nama database yang sama)
# untuk environment development atau production.

DB_HOST=localhost
DB_PORT=55432
DB_USER=test_user
DB_PASSWORD=test_pass_do_not_use_in_prod
DB_NAME=niskaladaisy_academy_test
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Secret JWT palsu (bukan secret produksi), hanya untuk menandatangani token di suite test.
JWT_SECRET=test-only-jwt-secret-for-premium-membership-suite-2026
